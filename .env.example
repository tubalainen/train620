# Kopiera till .env och fyll i nyckeln (https://api.trafikinfo.trafikverket.se)
TRAFIKVERKET_API_KEY=

# Lösenord till /admin (lägga till och ta bort tåg, import, radera allt).
# Lämnas det tomt är admin avstängt.
ADMIN_PASSWORD=

# Valfritt
# PORT=8843                    # port på värden för webbgränssnittet
# INITIAL_TRAINS=620           # tåg som bevakas vid första start (kommaseparerat)
# POLL_INTERVAL_SECONDS=300    # hur ofta Trafikverket tillfrågas
# DELAY_THRESHOLD_MIN=5        # försenat = mer än så här många minuter sent

# Säkerhet (valfritt)
# BIND_ADDRESS=0.0.0.0          # 127.0.0.1 = nåbar bara från servern (när proxyn kör på samma värd)
# TRUSTED_PROXIES=private       # vem som får ange besökarens IP (X-Forwarded-For/CF-Connecting-IP):
#                               # private = loopback och privata nät, none = ingen, eller nät som 172.18.0.0/16
# API_RATE_LIMIT_PER_MINUTE=120 # högsta antal API-anrop per IP och minut
